# Security
DEEPFAKE_API_KEY=replace-with-strong-key

# API controls
DEEPFAKE_RATE_LIMIT_PER_MINUTE=60
DEEPFAKE_MAX_UPLOAD_MB=50
DEEPFAKE_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500

# Threshold controls
DEEPFAKE_THRESHOLD_TEXT=0.0023
DEEPFAKE_THRESHOLD_IMAGE=0.568
DEEPFAKE_THRESHOLD_VIDEO=0.3055
DEEPFAKE_MARGIN_TEXT=0.0
DEEPFAKE_MARGIN_IMAGE=0.0
DEEPFAKE_MARGIN_VIDEO=0.2
DEEPFAKE_TEXT_STD_LIMIT=0.2
DEEPFAKE_IMAGE_STD_LIMIT=0.12
DEEPFAKE_VIDEO_STD_LIMIT=0.15

# Model overrides (optional)
DEEPFAKE_TEXT_MODEL=models\text_deberta_v3
DEEPFAKE_IMAGE_MODEL_PATH=
DEEPFAKE_VIDEO_MODEL_PATH=
